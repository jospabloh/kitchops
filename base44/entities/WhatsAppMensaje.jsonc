{
  // A single WhatsApp message, inbound or outbound. Two jobs:
  //   1. it is the agent's memory (the brain replays the last N for context);
  //   2. it is the record a human can read in the app's Bandeja tab to see
  //      exactly what the bot was told and what it answered — which matters
  //      because this bot writes to the books.
  //
  // `acciones` records what the agent actually DID for this message (the tool
  // calls it ran and the ids they produced), so a suspicious number in the
  // dashboard can be traced back to the sentence that caused it. The matching
  // AuditLog row is the durable, tamper-resistant copy; this one is the
  // conversational view.
  "name": "WhatsAppMensaje",
  "type": "object",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de este mensaje" },
    "conversacion_id": { "type": "string", "description": "WhatsAppConversacion.id" },
    "direccion": { "type": "string", "enum": ["entrante", "saliente"], "description": "entrante = del cliente al agente" },
    "texto": { "type": "string", "description": "Contenido del mensaje" },
    "media_url": { "type": "string", "description": "URL del adjunto (foto de ticket), si lo hubo" },
    "media_tipo": { "type": "string", "description": "MIME del adjunto" },
    "provider_event_id": { "type": "string", "description": "Id del evento del proveedor (trazabilidad; la deduplicación vive en WhatsAppEvento)" },
    "acciones": {
      "type": "array",
      "description": "Herramientas que ejecutó el agente por este mensaje: [{ tool, ok, entity, entity_id, detalle }]",
      "items": { "type": "object" }
    },
    "error": { "type": "string", "description": "Si el turno falló, qué falló — visible para el dueño sin abrir logs" },
    "enviado_at": { "type": "string", "format": "date-time" }
  },
  "required": ["business_id", "conversacion_id", "direccion"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": {
      "$or": [
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
