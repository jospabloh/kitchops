{
  "name": "Alerta",
  "type": "object",
  "description": "Una alerta generada por el motor de reglas (generarAlertas): gasto que se disparó, depósito que no llegó, insumo por agotarse, ticket sin facturar.",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de este registro" },
    "tipo": {
      "type": "string",
      "enum": ["gasto_alto", "deposito_faltante", "stock_bajo", "ticket_pendiente", "pago_pendiente"],
      "default": "gasto_alto"
    },
    "titulo": { "type": "string", "description": "Título corto de la alerta" },
    "mensaje": { "type": "string", "description": "Mensaje detallado" },
    "severidad": { "type": "string", "enum": ["verde", "amarillo", "rojo"], "default": "amarillo" },
    "fecha": { "type": "string", "format": "date-time", "description": "Fecha de generación" },
    "leida": { "type": "boolean", "default": false },
    "entidad_ref": { "type": "string", "description": "Referencia al registro relacionado" },
    "notificada_whatsapp": {
      "type": "boolean",
      "default": false,
      "description": "true cuando el agente de WhatsApp ya empujó esta alerta al dueño, para no repetirla en cada corrida."
    }
  },
  "required": ["business_id", "tipo", "titulo", "severidad"],
  // RLS (Module 4): las alertas las CREA el backend (generarAlertas corre como
  // servicio). Marcarlas como leídas también pasa por la función Safe
  // (Alertas:mark_read), así que las cuatro escrituras son sólo de servicio.
  "rls": {
    // Writes: service role only (role:admin). Every write goes through a Safe
    // function (_guard.ts: tenant, permission key, billing) — a tenant branch
    // here would let any member skip all three from the browser via the SDK.
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
