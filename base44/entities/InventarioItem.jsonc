{
  "name": "InventarioItem",
  "type": "object",
  "description": "Un insumo del almacén de la cocina, con su stock actual y el mínimo que dispara la alerta de reposición.",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de este registro" },
    "nombre": { "type": "string", "description": "Nombre del insumo" },
    "categoria": {
      "type": "string",
      "enum": ["Carnes", "Verduras", "Lácteos", "Bebidas", "Abarrotes", "Limpieza", "Otros"],
      "default": "Abarrotes"
    },
    "stock_actual": { "type": "number", "default": 0 },
    "stock_minimo": { "type": "number", "default": 0, "description": "Nivel mínimo de stock para alerta" },
    "unidad": { "type": "string", "default": "kg", "description": "Unidad de medida (kg, lt, pieza, etc.)" },
    "ultimo_costo": { "type": "number", "description": "Último costo de compra" },
    "proveedor": { "type": "string", "description": "Proveedor habitual" },
    "ultima_actualizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que se movió el stock (la escribe la función de inventario, no el cliente)"
    }
  },
  "required": ["business_id", "nombre"],
  // RLS (Module 4): staff ajusta stock a diario, pero por la función Safe
  // (Inventario:edit_stock); ultimo_costo es Inventario:edit_costo. Escrituras
  // sólo de servicio para que ninguna clave se pueda saltar por SDK.
  "rls": {
    // Writes: service role only (role:admin). Every write goes through a Safe
    // function (_guard.ts: tenant, permission key, billing) — a tenant branch
    // here would let any member skip all three from the browser via the SDK.
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
