{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "business_admin",
        "staff"
      ],
      "default": "staff",
      "description": "Rol del usuario. 'admin' es el nivel de plataforma ACACIA (no un rol de inquilino); 'business_admin' es el due\u00f1o/gerente del restaurante; 'staff' es el personal de cocina que captura gastos, inventario y cortes.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "business_id": {
      "type": "string",
      "description": "Negocio (Business.id) al que pertenece el usuario. Un usuario pertenece a un solo negocio: lo asigna complete-onboarding y s\u00f3lo manage-member (remove) lo limpia.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pending_business_id": {
      "type": "string",
      "description": "Solicitud de uni\u00f3n pendiente: Business.id al que la persona pidi\u00f3 entrar con un c\u00f3digo de invitaci\u00f3n. NO da acceso a nada: ninguna regla RLS ni _guard.ts lo lee, s\u00f3lo business_id cuenta. Lo escribe complete-onboarding (join) y lo limpia manage-member (aprobar/rechazar/quitar) o la propia persona (cancelar). Bloqueado a admin (s\u00f3lo escriben las funciones de servicio) para que nadie pueda inventar solicitudes a nombre de otra persona ni saltarse la aprobaci\u00f3n del due\u00f1o.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "join_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se envi\u00f3 la solicitud de uni\u00f3n (se muestra al due\u00f1o al aprobar). Va junto a pending_business_id y con el mismo bloqueo.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima actividad significativa (actualizada con throttle \u2265 15 min)"
    }
  },
  "required": []
}