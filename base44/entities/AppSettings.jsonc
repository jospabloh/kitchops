{
  // One row per business holding app-level preferences that aren't part of the
  // Business identity itself: the thresholds the alert engine reads, and the
  // weekly-cut convention. Created lazily on first save by
  // business:saveAppSettingsSafe, which is idempotent — if a row already exists
  // for the business (another tab raced it, or a retry), it updates that row
  // instead of creating a duplicate.
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de este registro" },
    "gasto_alto_umbral_pct": { "type": "number", "default": 20, "description": "Aumento mes contra mes (%) que dispara la alerta de gasto alto" },
    "gasto_alto_critico_pct": { "type": "number", "default": 50, "description": "Aumento (%) a partir del cual la alerta se marca en rojo" },
    "deposito_diferencia_critica": { "type": "number", "default": 500, "description": "Diferencia entre corte y depósito a partir de la cual la alerta es roja" },
    "semana_inicia_lunes": { "type": "boolean", "default": true, "description": "Si la semana de corte inicia en lunes (si no, en domingo)" },
    "alertas_email": { "type": "string", "description": "Correo al que se envían las alertas críticas" },
    "alertas_whatsapp_activas": { "type": "boolean", "default": false, "description": "Empujar alertas críticas por WhatsApp al dueño" },
    "alertas_whatsapp_destino": { "type": "string", "description": "Número E.164 al que se empujan las alertas críticas" },
    "moneda_simbolo": { "type": "string", "default": "$", "description": "Símbolo de moneda a mostrar" }
  },
  "required": ["business_id"],
  // RLS (Module 4): configuración del negocio — sólo business_admin la cambia.
  "rls": {
    "create": {
      "$or": [
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
