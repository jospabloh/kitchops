{
  // One row per (business, WhatsApp counterpart). This is the agent's memory
  // anchor: WhatsAppMensaje rows hang off it, and the brain replays the last N
  // of them as conversation history so "y el de ayer?" means something.
  //
  // `conversation_id` is the provider's own id (Zernio needs it — plus the
  // accountId — to send a reply at all; the phone number alone is not enough,
  // and since April 2026 may not even be present on the inbound payload).
  "name": "WhatsAppConversacion",
  "type": "object",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de esta conversación" },
    "conversation_id": { "type": "string", "description": "Id de conversación del proveedor. Necesario para responder." },
    "telefono": { "type": "string", "description": "Número del interlocutor en E.164, cuando el proveedor lo manda" },
    "nombre_contacto": { "type": "string", "description": "Nombre que reporta WhatsApp" },
    "autorizado": {
      "type": "boolean",
      "default": false,
      "description": "Si el número está en la allowlist de WhatsAppConfig. Se recalcula en cada mensaje — no es una decisión que se cachee y se quede vieja cuando el dueño quita a alguien."
    },
    "rol_efectivo": {
      "type": "string",
      "enum": ["business_admin", "staff"],
      "description": "Rol con el que actúa este número, copiado de la allowlist. Es lo que consulta el chequeo de permisos del agente."
    },
    "mensajes_count": { "type": "number", "default": 0 },
    "ultimo_mensaje_at": { "type": "string", "format": "date-time" },
    "ultimo_mensaje_texto": { "type": "string", "description": "Vista previa para la bandeja en la app" }
  },
  "required": ["business_id", "conversation_id"],
  "rls": {
    // Sólo el webhook (servicio) crea y mueve conversaciones.
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": {
      "$or": [
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
