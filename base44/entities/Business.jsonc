{
  // Business — the tenant entity for KitchOps (one restaurant / cocina).
  //
  // MODULE 1 of the ACACIA portfolio standard: `billing_status` is written
  // ONLY by Mission Control's unified lifecycle cron
  // (acacia-mission-control/api/cron/license-lifecycle.js). KitchOps READS it
  // to degrade the UI (view_only / suspended), and never runs its own
  // trial/renewal/reminder cron. Do not add one.
  //
  // Every other entity in this app carries `business_id` pointing at this
  // row's built-in `id`, which is why this entity's RLS scopes by `id`
  // (a built-in) rather than `data.business_id` (see Module 4).
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del negocio / restaurante"
    },
    "legal_name": {
      "type": "string",
      "description": "Razón social"
    },
    "rfc": {
      "type": "string",
      "description": "RFC del negocio"
    },
    "phone": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "address": {
      "type": "string",
      "description": "Dirección de la sucursal principal"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logotipo del negocio"
    },
    "currency": {
      "type": "string",
      "default": "MXN",
      "description": "Moneda de operación"
    },
    "tax_rate": {
      "type": "number",
      "default": 16,
      "description": "Tasa de IVA aplicable (%)"
    },
    "timezone": {
      "type": "string",
      "default": "America/Mexico_City",
      "description": "Zona horaria para cortes semanales y alertas"
    },
    "invite_code": {
      "type": "string",
      "description": "Código único de invitación para que el equipo se una"
    },
    "invite_code_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el código de invitación acepta nuevos miembros"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "default": "trial",
      "description": "Estado de licencia. LO ESCRIBE ÚNICAMENTE el cron unificado de ACACIA Mission Control; esta app solo lo lee para degradar la UI."
    },
    "license_plan": {
      "type": "string",
      "enum": [
        "start",
        "growth",
        "pro"
      ],
      "default": "start",
      "description": "Plan contratado"
    },
    "licensed_user_limit": {
      "type": "number",
      "default": 4,
      "description": "Número de usuarios incluidos en el plan"
    },
    "trial_start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Inicio del periodo de prueba"
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin del periodo de prueba"
    },
    "license_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de activación de la licencia"
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin del periodo actual de facturación"
    },
    "view_only_since": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el negocio entró en modo solo lectura"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia del último pago (Mercado Pago)"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Renovación automática de la licencia"
    },
    "scheduled_delete_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha programada de eliminación permanente (zona de peligro)"
    },
    "deletion_requested_by": {
      "type": "string",
      "description": "Email de quien solicitó la eliminación de la cuenta"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
