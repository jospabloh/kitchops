{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del negocio / restaurante"
    },
    "legal_name": {
      "type": "string",
      "description": "Raz\u00f3n social"
    },
    "rfc": {
      "type": "string",
      "description": "RFC del negocio"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n de la sucursal principal"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logotipo del negocio"
    },
    "currency": {
      "type": "string",
      "default": "MXN",
      "description": "Moneda de operaci\u00f3n"
    },
    "tax_rate": {
      "type": "number",
      "default": 16,
      "description": "Tasa de IVA aplicable (%)"
    },
    "timezone": {
      "type": "string",
      "default": "America/Mexico_City",
      "description": "Zona horaria para cortes semanales y alertas"
    },
    "invite_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de invitaci\u00f3n para que el equipo se una"
    },
    "invite_code_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el c\u00f3digo de invitaci\u00f3n acepta nuevos miembros"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "default": "trial",
      "description": "Estado de licencia. LO ESCRIBE \u00daNICAMENTE el cron unificado de ACACIA Mission Control; esta app solo lo lee para degradar la UI."
    },
    "license_plan": {
      "type": "string",
      "enum": [
        "start",
        "growth",
        "pro"
      ],
      "default": "start",
      "description": "Plan contratado"
    },
    "licensed_user_limit": {
      "type": "number",
      "default": 4,
      "description": "N\u00famero de usuarios incluidos en el plan"
    },
    "trial_start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Inicio del periodo de prueba"
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin del periodo de prueba"
    },
    "license_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de activaci\u00f3n de la licencia"
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin del periodo actual de facturaci\u00f3n"
    },
    "view_only_since": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el negocio entr\u00f3 en modo solo lectura"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia del \u00faltimo pago (Mercado Pago)"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Renovaci\u00f3n autom\u00e1tica de la licencia"
    },
    "scheduled_delete_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha programada de eliminaci\u00f3n permanente (zona de peligro)"
    },
    "deletion_requested_by": {
      "type": "string",
      "description": "Email de quien solicit\u00f3 la eliminaci\u00f3n de la cuenta"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}