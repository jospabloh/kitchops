{
  "name": "Gasto",
  "type": "object",
  "description": "Un gasto del restaurante: compra a proveedor, servicio, renta, mantenimiento. Es la entidad que más se captura desde WhatsApp (foto del ticket).",
  "properties": {
    "business_id": { "type": "string", "description": "Tenant (Business.id) dueño de este registro" },
    "monto": { "type": "number", "description": "Monto total del gasto" },
    "fecha": { "type": "string", "format": "date", "description": "Fecha del gasto" },
    "proveedor": { "type": "string", "description": "Nombre del proveedor" },
    "categoria": {
      "type": "string",
      "enum": ["Insumos", "Servicios", "Renta", "Equipos", "Mantenimiento", "Otros"],
      "default": "Insumos"
    },
    "metodo_pago": {
      "type": "string",
      "enum": ["Tarjeta de crédito", "Transferencia", "Efectivo", "Otros"],
      "default": "Tarjeta de crédito"
    },
    "ticket_foto_url": { "type": "string", "description": "URL de la foto del ticket" },
    "descripcion": { "type": "string", "description": "Descripción del gasto" },
    "facturado": { "type": "boolean", "default": false },
    "pagado": { "type": "boolean", "default": false },
    "semana": { "type": "string", "description": "Semana del gasto (YYYY-WW)" },
    "origen": {
      "type": "string",
      "enum": ["app", "whatsapp"],
      "default": "app",
      "description": "Cómo se capturó el gasto. 'whatsapp' lo escribe el agente de WhatsApp vía función de servicio."
    }
  },
  "required": ["business_id", "monto", "fecha", "proveedor"],
  // RLS (Module 4): read keeps the tenant branch; create/update/delete are
  // service-role only. Quién captura, corrige, marca pagado o borra lo decide la
  // función Safe con la clave de permiso (Gastos:*), no esta regla: con una rama
  // de inquilino aquí, un staff marcaría pagos sin Gastos:mark_pagado por SDK.
  "rls": {
    // Writes: service role only (role:admin). Every write goes through a Safe
    // function (_guard.ts: tenant, permission key, billing) — a tenant branch
    // here would let any member skip all three from the browser via the SDK.
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.business_id": "{{user.data.business_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
